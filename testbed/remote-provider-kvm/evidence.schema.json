{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Doldas/flowerly_os/testbed/remote-provider-kvm/evidence.schema.json",
  "title": "Remote provider Arch/KVM acceptance evidence",
  "description": "Structural schema. scripts/remote-provider-kvm-evidence.py enforces the same structure plus the rules a schema cannot express: catalog coverage, no PASS outside an executed run, and the leak scan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "test_suite", "phase", "run_id", "summary", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "test_suite": {"const": "remote-provider-arch-kvm"},
    "phase": {"enum": ["preparation", "execution"]},
    "run_id": {"type": "string", "pattern": "^[a-z0-9-]{8,64}$"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "counts"],
      "properties": {
        "overall": {"$ref": "#/$defs/status"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_RUN"],
          "properties": {
            "PASS": {"type": "integer", "minimum": 0},
            "FAIL": {"type": "integer", "minimum": 0},
            "INCONCLUSIVE": {"type": "integer", "minimum": 0},
            "NOT_RUN": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "results": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_RUN"]},
    "sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "test_suite", "test_id", "exercises", "git_commit", "git_tree_clean",
                   "guest_image", "guest_image_sha256", "guest_kernel", "systemd_version",
                   "providerd_sha256", "unit_sha256", "test_started_at_utc", "test_finished_at_utc",
                   "test_status", "expected", "observed", "classification", "skip_reason", "artifacts"],
      "properties": {
        "schema_version": {"const": 1},
        "test_suite": {"const": "remote-provider-arch-kvm"},
        "test_id": {"type": "string", "pattern": "^[A-Z][0-9]{1,2}$"},
        "exercises": {"enum": ["production", "harness"]},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_tree_clean": {"type": "boolean"},
        "guest_image": {"type": ["string", "null"]},
        "guest_image_sha256": {"$ref": "#/$defs/sha"},
        "guest_kernel": {"type": ["string", "null"]},
        "systemd_version": {"type": ["string", "null"]},
        "providerd_sha256": {"$ref": "#/$defs/sha"},
        "unit_sha256": {"$ref": "#/$defs/sha"},
        "test_started_at_utc": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "test_finished_at_utc": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "test_status": {"$ref": "#/$defs/status"},
        "expected": {},
        "observed": {},
        "classification": {"type": ["string", "null"], "maxLength": 64},
        "skip_reason": {"type": ["string", "null"], "maxLength": 500},
        "artifacts": {"type": "array", "items": {"type": "string", "maxLength": 200}}
      }
    }
  }
}
