[Unit]
Description=Flowerly Gate D Admin drill (A/B test image only, ADR-0023 G5)
# Ordering only: an unhealthy boot must still report (the drill then skips).
After=flowerly-generation-health.service flowerlyd.service flowerly-slot-broker.socket
RequiresMountsFor=/var/lib/flowerly /efi

[Service]
Type=oneshot
User=root
Group=root
# Runs every Admin step as flowerly-drill through agenticctl (runuser).
ExecStart=/usr/bin/python3 /usr/lib/flowerly/g5-drill.py
StandardOutput=journal
StandardError=journal+console
TimeoutStartSec=900
PrivateNetwork=yes

[Install]
WantedBy=multi-user.target
