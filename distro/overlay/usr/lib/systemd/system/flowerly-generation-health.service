[Unit]
Description=Flowerly A/B IPC health gate before systemd-boot blessing (test image only)
Requires=flowerlyd.service flowerly-generation-witness.service
After=flowerlyd.service flowerly-generation-witness.service
RequiresMountsFor=/var/lib/flowerly

[Service]
Type=oneshot
User=root
Group=root
TimeoutStartSec=65
ExecStartPre=/usr/bin/bash /usr/lib/flowerly/generation-health-gate.sh
ExecStart=/usr/bin/bash /usr/lib/flowerly/generation-bless.sh
ExecStartPost=/usr/bin/echo FLOWERLY_GENERATION_BOOT_BLESSED
# Resolve a pending activation from the ledger now that this boot is healthy.
ExecStartPost=/usr/bin/runuser -u flowerly -- /usr/bin/agenticctl --runtime-dir /run/flowerly generation resolve
StandardOutput=journal+console
StandardError=journal+console
NoNewPrivileges=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
