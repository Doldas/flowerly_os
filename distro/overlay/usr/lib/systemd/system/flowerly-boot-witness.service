[Unit]
Description=Flowerly OS boot activation witness
Requires=flowerlyd.service
After=flowerlyd.service

[Service]
Type=oneshot
User=flowerly
Group=flowerly
TimeoutStartSec=45
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/bin/bash /usr/lib/flowerly/boot-ipc-health.sh

[Install]
WantedBy=multi-user.target
